---
import Base from '../layouts/Base.astro';
import ApplyForm from '../components/ApplyForm.astro';
import { tiers, usd } from '../data/membership';

const questions = [
  { q: 'Do I need a car to join?', a: 'No. Cars are part of what we do, not a condition of belonging.' },
  { q: 'Is this only for business owners?', a: 'No. We’re looking for good company, whatever you do.' },
  { q: 'What happens after twenty-five?', a: 'Founders membership closes. The founder rate stays with the people who hold it.' },
];
---

<Base
  title="Membership"
  description="Founders membership at Desert Social: twenty-five places, $250 to join and $50 a month. See what's included and apply."
>
  <header class="page-head">
    <div class="wrap">
      <p class="label" data-reveal>Membership</p>
      <h1 class="display" data-reveal style="--d:.06s">Founders <em>membership.</em></h1>
      <p class="lede" data-reveal style="--d:.12s">{tiers[0].summary}</p>
    </div>
  </header>

  {
    tiers.map((tier) => (
      <section class="section tone-bone offer">
        <div class="wrap">
          <dl class="figures" data-reveal>
            <div>
              <dt class="label">Places</dt>
              <dd>{tier.cap}</dd>
            </div>
            <div>
              <dt class="label">To join</dt>
              <dd>{usd(tier.initiation)}</dd>
            </div>
            <div>
              <dt class="label">Each month</dt>
              <dd>{usd(tier.monthly)}</dd>
            </div>
          </dl>

          <div class="offer__body">
            <div data-reveal>
              <h2 class="label offer__head">Included now</h2>
              <ul class="included">
                {tier.includedNow.map((item) => (
                  <li>
                    <h3>{item.title}</h3>
                    <p>{item.detail}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div data-reveal style="--d:.06s">
              <h2 class="label offer__head">What we’re building</h2>
              <p class="building">{tier.beingBuilt.map((item) => item.title).join(' · ')}</p>
              <p class="small">
                Where we’re headed, not a schedule. Founders are offered each one first.
              </p>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section" id="apply">
    <div class="wrap grid">
      <div class="col-label" data-reveal>
        <p class="label">Apply</p>
        <ol class="steps">
          <li>Apply here</li>
          <li>We talk</li>
          <li>You join</li>
        </ol>
        <p class="small">
          Applying is free. If you’re accepted, we send a payment link. Nothing is charged through this site.
        </p>
      </div>
      <div class="col-main" data-reveal>
        <h2 class="display apply__title">Tell us about you.</h2>
        <ApplyForm />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <p class="label col-label" data-reveal>Questions</p>
      <div class="col-main">
        <dl class="rows" data-reveal>
          {
            questions.map((item) => (
              <div class="row">
                <dt class="row__title">{item.q}</dt>
                <dd class="row__text">{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }
  .figures > div {
    padding: clamp(1.25rem, 3vw, 2rem) clamp(0.75rem, 2.5vw, 2rem);
    border-left: 1px solid var(--rule);
  }
  .figures > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .figures dd {
    margin-top: 0.6rem;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 1.3rem + 5vw, 6rem);
    font-weight: 280;
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-variant-numeric: lining-nums;
  }

  .offer__body {
    display: grid;
    gap: 2.5rem clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 60rem) {
    .offer__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .offer__head {
    margin-bottom: 1.1rem;
  }
  .included {
    display: grid;
    gap: 1.25rem;
  }
  .included h3 {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.65rem);
    font-weight: 340;
    line-height: 1.2;
  }
  .included p {
    margin-top: 0.25rem;
    color: var(--fg-soft);
    max-width: 30rem;
  }
  .building {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.45rem);
    line-height: 1.45;
    color: var(--fg-soft);
    margin-bottom: 0.9rem;
  }

  #apply {
    scroll-margin-top: 4rem;
  }
  .steps {
    display: grid;
    gap: 0.4rem;
    margin-block: 1.25rem;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    font-family: var(--serif);
    font-size: 1.25rem;
  }
  .steps li::before {
    content: counter(step) '.';
    display: inline-block;
    width: 1.5rem;
    color: var(--accent);
  }
  .col-label .small {
    max-width: 17rem;
  }
  .apply__title {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
