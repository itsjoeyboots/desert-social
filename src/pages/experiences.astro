---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Upcoming from '../components/Upcoming.astro';
import Invitation from '../components/Invitation.astro';
import { upcoming } from '../data/events';

const entries = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);
const experiences = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Base
  title="Experiences"
  description="How Desert Social spends time together: drives, dinners, business meetups, private gatherings and collaborations with local partners."
>
  <header class="page-head">
    <div class="wrap">
      <p class="label" data-reveal>Experiences</p>
      <h1 class="display" data-reveal style="--d:.06s">Reasons to be <em>in the same place.</em></h1>
      <p class="lede" data-reveal style="--d:.12s">
        Five ways we spend time together. Dates go to Founders first.
      </p>
    </div>
  </header>

  <section class="section section--list">
    <div class="wrap">
      {
        experiences.map(({ entry, Content }) => (
          <article class="exp" id={entry.id} data-reveal>
            <div class="exp__head">
              <h2 class="title">{entry.data.title}</h2>
              <p class="label">{entry.data.kind}</p>
            </div>
            <div class="exp__body">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {
    upcoming().length > 0 && (
      <section class="section">
        <div class="wrap grid">
          <p class="label col-label" data-reveal>
            Upcoming
          </p>
          <div class="col-main" data-reveal>
            <Upcoming />
          </div>
        </div>
      </section>
    )
  }

  <Invitation />
</Base>

<style>
  .section--list {
    padding-top: 0;
  }
  .exp {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  .exp:first-child {
    border-top-color: var(--rule-strong);
  }
  .exp__head .label {
    margin-top: 0.6rem;
  }
  .exp__body {
    color: var(--fg-soft);
    max-width: var(--measure);
  }
  @media (min-width: 52rem) {
    .exp {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
</style>
