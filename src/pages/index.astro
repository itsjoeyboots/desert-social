---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ridges from '../components/Ridges.astro';
import Upcoming from '../components/Upcoming.astro';
import Invitation from '../components/Invitation.astro';
import { site, href } from '../data/site';
import { upcoming } from '../data/events';

const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);
const hasDates = upcoming().length > 0;
---

<Base>
  <section class="hero">
    <Ridges />
    <div class="wrap hero__inner">
      <p class="label" data-reveal>{site.location}</p>
      <h1 class="hero-title" data-reveal style="--d:.08s">
        Good company is built <em>in person.</em>
      </h1>
      <p class="lede" data-reveal style="--d:.16s">
        A community for people who build things and would rather meet across a table than through a screen.
      </p>
      <div class="hero__actions" data-reveal style="--d:.22s">
        <a class="btn" href={href('/membership/#apply')}>Apply for Founders</a>
        <a class="arrow-link" href="#what">What it is</a>
      </div>
    </div>
  </section>

  <section class="section" id="what">
    <div class="wrap grid">
      <p class="label col-label" data-reveal>What it is</p>
      <div class="col-main stack" style="--stack:1.75rem">
        <h2 class="display" data-reveal>A social network that exists in the real world.</h2>
        <p class="lede" data-reveal>
          We bring good people together over long dinners, early drives and conversations worth staying for.
          Friendships, introductions and the occasional deal follow on their own.
        </p>
        <dl class="facts" data-reveal>
          <div>
            <dt class="label">Who it’s for</dt>
            <dd>Founders and owners, professionals, drivers and collectors, investors, creatives.</dd>
          </div>
          <div>
            <dt class="label">What it isn’t</dt>
            <dd>Not a car club. Not a networking group. Not a country club.</dd>
          </div>
        </dl>
        <p data-reveal><a class="arrow-link" href={href('/about/')}>Why we started</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <p class="label col-label" data-reveal>Experiences</p>
      <div class="col-main">
        <ul class="rows" data-reveal>
          {
            experiences.map((e) => (
              <li>
                <a class="row row--link" href={href(`/experiences/#${e.id}`)}>
                  <span class="row__title">{e.data.title}</span>
                  <span class="row__text">{e.data.summary}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="more" data-reveal><a class="arrow-link" href={href('/experiences/')}>All experiences</a></p>
      </div>
    </div>
  </section>

  {
    hasDates && (
      <section class="section">
        <div class="wrap grid">
          <p class="label col-label" data-reveal>
            Upcoming
          </p>
          <div class="col-main" data-reveal>
            <Upcoming />
          </div>
        </div>
      </section>
    )
  }

  <Invitation />
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(88svh, 52rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--ink) 0%, rgba(13, 13, 12, 0.82) 38%, rgba(13, 13, 12, 0.2) 100%),
      linear-gradient(to top, var(--ink) 0%, rgba(13, 13, 12, 0) 34%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-top: 8rem;
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    justify-items: start;
  }
  .hero-title {
    max-width: 12ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 0.5rem;
  }

  .facts {
    display: grid;
    gap: 1.25rem 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 52rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .facts .label {
    margin-bottom: 0.5rem;
  }
  .facts dd {
    color: var(--fg-soft);
    max-width: 28rem;
  }
  .more {
    margin-top: 2rem;
  }
</style>
