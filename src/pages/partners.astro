---
import Base from '../layouts/Base.astro';
import PartnerForm from '../components/PartnerForm.astro';

const who = ['Venues', 'Automotive businesses', 'Local businesses', 'Brands', 'Sponsors', 'Hosts and creatives'];
---

<Base
  title="Partners"
  description="Work with Desert Social. We collaborate with venues, automotive businesses, local brands and sponsors in Gilbert and the East Valley. Send a partnership inquiry."
>
  <header class="page-head">
    <div class="wrap">
      <p class="label" data-reveal>Partners</p>
      <h1 class="display" data-reveal style="--d:.06s">Built with people who <em>do things well.</em></h1>
      <p class="lede" data-reveal style="--d:.12s">
        We work with businesses, venues and brands our members would want to know about anyway. No rate card,
        no packages: every collaboration starts from what would make a good night.
      </p>
      <ul class="tags" data-reveal style="--d:.16s" aria-label="Who we work with">
        {who.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </header>

  <section class="section section--flush" id="inquire">
    <div class="wrap grid">
      <div class="col-label" data-reveal>
        <p class="label">Inquire</p>
        <p class="small aside">
          If it isn’t right for our members, we’ll say so and say why.
        </p>
      </div>
      <div class="col-main" data-reveal>
        <h2 class="display form-title">Start the conversation.</h2>
        <PartnerForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .tags li {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--rule-strong);
    font-size: 0.9rem;
    color: var(--fg-soft);
  }
  #inquire {
    scroll-margin-top: 4rem;
    border-top: 1px solid var(--rule);
  }
  .aside {
    margin-top: 1rem;
    max-width: 16rem;
  }
  .form-title {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
