---
import Base from '../layouts/Base.astro';
import Ridges from '../components/Ridges.astro';
import { href } from '../data/site';
---

<Base title="Page not found" noindex>
  <section class="lost">
    <Ridges seed={19} layers={7} />
    <div class="wrap lost__inner">
      <p class="label"><span class="num">404</span>Page not found</p>
      <h1 class="display">Wrong turn. <em>It happens.</em></h1>
      <p class="lede">That page doesn’t exist, or it moved.</p>
      <div class="btn-row">
        <a class="btn" href={href('/')}>Back to the start</a>
        <a class="btn btn--ghost" href={href('/contact/')}>Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .lost::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--ink) 0%, rgba(13, 13, 12, 0.8) 45%, rgba(13, 13, 12, 0.25) 100%);
    pointer-events: none;
  }
  .lost__inner {
    position: relative;
    z-index: 1;
    padding-block: 8rem 4rem;
  }
  .lost .label {
    margin-bottom: 1.75rem;
  }
  .lost .lede {
    margin-top: 1.5rem;
  }
  .lost .btn-row {
    margin-top: 2.5rem;
  }
</style>
