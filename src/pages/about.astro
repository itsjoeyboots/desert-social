---
import Base from '../layouts/Base.astro';
import Invitation from '../components/Invitation.astro';

const chapters = [
  {
    label: 'Why',
    title: 'Full feeds, empty calendars.',
    text: 'It has never been easier to stay in touch and never harder to actually meet anyone. Most events don’t help: you stand in a crowd, trade a few names and go home.',
  },
  {
    label: 'How we host',
    title: 'People in a room, on purpose.',
    text: 'Small groups, settings with character, a guest list put together with care. This grew out of car culture, and a good drive is still one of the easiest ways to start talking. But you don’t need a car to belong here.',
  },
  {
    label: 'Where it’s going',
    title: 'One good night at a time.',
    text: 'More kinds of gatherings, partnerships with venues and businesses we respect, and in time a place of our own. We’d rather build it properly than quickly.',
  },
];

const rules = [
  { title: 'Show up.', text: 'A community is the people who come.' },
  { title: 'Be generous.', text: 'With introductions, attention and what you know.' },
  { title: 'Leave the ego outside.', text: 'How you carry what you’ve built matters more.' },
  { title: 'No selling from the stage.', text: 'If the work is good, people will ask.' },
];
---

<Base
  title="About"
  description="Why Desert Social exists: real-world connection for people who would rather meet in person. What we believe and how we host."
>
  <header class="page-head">
    <div class="wrap">
      <p class="label" data-reveal>About</p>
      <h1 class="display" data-reveal style="--d:.06s">
        The best things in most lives started <em>in a room</em> with the right people.
      </h1>
      <p class="lede" data-reveal style="--d:.12s">
        A job, a business partner, a friend who became family. None of it began with a follow request. Desert
        Social exists to make more of those rooms.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="chapters">
        {
          chapters.map((c, i) => (
            <article data-reveal style={`--d:${i * 0.06}s`}>
              <p class="label">{c.label}</p>
              <h2 class="title">{c.title}</h2>
              <p>{c.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <p class="label col-label" data-reveal>House rules</p>
      <div class="col-main">
        <ul class="rows" data-reveal>
          {
            rules.map((r) => (
              <li class="row">
                <h3 class="row__title">{r.title}</h3>
                <p class="row__text">{r.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Invitation />
</Base>

<style>
  .page-head .display {
    max-width: 18ch;
  }
  .chapters {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 60rem) {
    .chapters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }
  .chapters article {
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-strong);
  }
  .chapters .title {
    margin-block: 1rem 0.9rem;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem);
  }
  .chapters article > p:last-child {
    color: var(--fg-soft);
    max-width: 30rem;
  }
</style>
