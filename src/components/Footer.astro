---
import Wordmark from './Wordmark.astro';
import { site, nav, href } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__mark">
      <Wordmark size="lg" />
    </div>

    <div class="site-footer__cols">
      <div>
        <p class="label">Explore</p>
        <ul>
          {nav.map((item) => <li><a href={href(item.path)}>{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="label">Get in touch</p>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {
            site.social.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.label} <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="label">Where</p>
        <ul>
          <li>{site.location}</li>
        </ul>
      </div>
    </div>

    <div class="site-footer__base">
      <p>© {year} {site.name}</p>
      <a href={href('/privacy/')}>Privacy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--bone);
    border-top: 1px solid rgba(239, 234, 225, 0.14);
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) 2rem;
  }
  .site-footer__mark {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }
  .site-footer__cols {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    padding-block: 2.5rem;
    border-top: 1px solid rgba(239, 234, 225, 0.14);
  }
  .site-footer__cols .label {
    margin-bottom: 1.1rem;
    color: var(--stone);
  }
  .site-footer__cols li {
    color: var(--sand);
  }
  .site-footer__cols a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--sand);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .site-footer__cols a:hover {
    color: var(--bone);
  }
  .site-footer__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(239, 234, 225, 0.14);
    font-size: var(--t-small);
    color: var(--stone);
  }
  .site-footer__base {
    align-items: center;
  }
  .site-footer__base a {
    display: inline-block;
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: none;
  }
  .site-footer__base a:hover {
    color: var(--bone);
  }
</style>
