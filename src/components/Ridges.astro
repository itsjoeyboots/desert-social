---
// Desert ridgelines, drawn rather than photographed. Layers of low mountain
// silhouettes stepping back to a horizon line. The shapes are generated from
// a fixed seed, so every build draws the same range.
interface Props {
  seed?: number;
  layers?: number;
  class?: string;
}
const { seed = 7, layers = 9, class: className } = Astro.props;

const W = 1600;
const H = 900;

function rng(s: number) {
  let a = s >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(seed);
const horizon = H * 0.36;

const paths = Array.from({ length: layers }, (_, i) => {
  const depth = i / (layers - 1); // 0 = far, 1 = near
  const base = horizon + depth * depth * (H - horizon) * 0.92 + 14;
  const amp = 16 + depth * 120;
  const waves = [0, 1, 2, 3].map((k) => ({
    f: (0.0016 + rand() * 0.0034) * (k + 1) * (1.5 - depth * 0.6),
    p: rand() * Math.PI * 2,
    a: amp / (k * 1.7 + 1),
  }));
  let d = '';
  for (let x = -20; x <= W + 20; x += 16) {
    let y = base;
    for (const w of waves) y -= Math.abs(Math.sin(x * w.f + w.p)) * w.a * 0.5;
    d += (x === -20 ? 'M' : 'L') + x + ' ' + y.toFixed(1);
  }
  return { d, opacity: (0.16 + depth * 0.34).toFixed(2) };
});
---

<svg
  class:list={['ridges', className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <line class="ridges__horizon" x1="0" x2={W} y1={horizon} y2={horizon}></line>
  <circle class="ridges__sun" cx={W * 0.74} cy={horizon} r="118"></circle>
  {paths.map((p) => <path d={p.d} style={`opacity:${p.opacity}`} />)}
</svg>

<style>
  .ridges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--fg);
  }
  .ridges path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ridges__horizon {
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }
  .ridges__sun {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.5;
    vector-effect: non-scaling-stroke;
    clip-path: inset(0 0 50% 0);
  }
</style>
