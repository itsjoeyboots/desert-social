---
import Form from './Form.astro';
import Field from './Field.astro';
import { contactTopics } from '../data/forms';
---

<Form
  kind="contact"
  submitLabel="Send message"
  doneTitle="Message received."
  doneText="Thanks for writing. We’ll reply to the email address you gave us."
>
  <Field name="full_name" label="Your name" required autocomplete="name" half />
  <Field name="email" label="Email" type="email" required autocomplete="email" inputmode="email" half />
  <Field name="topic" label="What’s it about?" type="select" options={contactTopics} required />
  <Field name="message" label="Message" type="textarea" required maxlength={2000} />
</Form>
